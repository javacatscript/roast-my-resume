# Free key from https://console.groq.com
GROQ_API_KEY=
# Confirm the current free-tier model id in the Groq console before relying on the default.
# GROQ_MODEL=
# Optional: free Upstash Redis for per-IP rate limiting. Without these, limiting is in-memory (weak on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
